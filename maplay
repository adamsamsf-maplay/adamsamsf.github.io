<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Maplay — music that moves with you</title>
<meta name="description" content="Personalized audio routes that match pace, place, and mood. Join the Maplay waitlist." />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --accent:#FF5A5F;
  --bg:#ffffff;
  --muted:#6B7280;
  --card:#F8FAFC;
  --max-width:1100px;
  --radius:12px;
  --glass: rgba(11,18,32,0.04);
}
*{box-sizing:border-box}
body{font-family:Inter,system-ui,Arial,sans-serif;margin:0;background:var(--bg);color:#071029;line-height:1.45}
.container{max-width:var(--max-width);margin:0 auto;padding:36px}
.header{display:flex;align-items:center;justify-content:space-between;padding:18px 0}
.logo{font-weight:700;color:#071029;letter-spacing:0.2px}
.nav a{margin-left:18px;color:var(--muted);text-decoration:none;font-weight:600;font-size:0.95rem}
.hero{display:flex;gap:28px;align-items:center;padding:36px 0}
.hero-left{flex:1}
.hero-right{flex:1;display:flex;justify-content:center}
h1{font-size:2.25rem;margin:0 0 12px 0;color:#071029}
.lead{color:var(--muted);margin:0 0 20px 0;font-size:1.05rem}
.cta-row{display:flex;gap:12px;flex-wrap:wrap}
.btn{padding:12px 18px;border-radius:10px;text-decoration:none;font-weight:700;display:inline-block}
.btn.primary{background:var(--accent);color:#fff}
.btn.ghost{background:transparent;border:1px solid #E6EEF6;color:#071029}
.mockup img{width:280px;border-radius:18px;box-shadow:0 18px 40px rgba(12,20,40,0.08)}
.section{padding:36px 0;border-top:1px solid #F1F5F9}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 18px rgba(12,20,40,0.03)}
.card h3{margin:0 0 8px 0;font-size:1.05rem}
.card p{margin:0;color:var(--muted);font-size:0.95rem}
.how{display:flex;gap:24px;align-items:flex-start}
.how-step{flex:1;background:linear-gradient(180deg,#fff,#fbfdff);padding:18px;border-radius:12px;border:1px solid #EEF2F7}
.how-step h4{margin:0 0 8px 0}
.testimonials{display:flex;flex-direction:column;gap:12px}
.testimonial{background:var(--glass);padding:14px;border-radius:10px}
.footer{padding:28px 0;color:var(--muted);font-size:0.95rem;display:flex;justify-content:space-between;align-items:center}
.small{font-size:0.9rem;color:var(--muted)}
@media(max-width:900px){
  .hero{flex-direction:column}
  .grid{grid-template-columns:1fr}
  h1{font-size:1.6rem}
  .mockup img{width:220px}
  .header{padding:12px 0}
}
</style>
</head>
<body>
  <header class="container header">
    <div class="logo">Maplay</div>
    <nav class="nav">
      <a href="#how">How it works</a>
      <a href="#features">Features</a>
      <a href="#team">Team</a>
      <a href="#waitlist" class="btn ghost">Join waitlist</a>
    </nav>
  </header>

  <main class="container">
    <!-- Hero -->
    <section class="hero" id="home">
      <div class="hero-left">
        <h1>Maplay — music that moves with you</h1>
        <p class="lead">Personalized audio routes that match pace, place, and mood. Turn every journey into a soundtrack.</p>
        <div class="cta-row">
          <a class="btn primary" id="waitlist" href="#waitlist">Join the waitlist</a>
          <a class="btn ghost" href="#how">How it works</a>
        </div>
      </div>
      <div class="hero-right">
        <div class="mockup">
          <img src="/assets/mockup-phone.png" alt="Maplay app preview">
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="section" id="features">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px">
        <h2 style="margin:0">What Maplay does</h2>
        <div class="small">Built for commuters, runners, and explorers</div>
      </div>
      <div class="grid">
        <div class="card">
          <h3>Contextual playlists</h3>
          <p>Playlists adapt to route, speed, and environment so your soundtrack fits the moment.</p>
        </div>
        <div class="card">
          <h3>Smart transitions</h3>
          <p>Smooth crossfades and tempo matching keep energy consistent across stops and turns.</p>
        </div>
        <div class="card">
          <h3>Privacy-first location</h3>
          <p>Local processing and minimal data sharing — control what you share and when.</p>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="section" id="how">
      <h2 style="margin:0 0 12px 0">How it works</h2>
      <div class="how">
        <div class="how-step">
          <h4>1. Tell Maplay your route</h4>
          <p class="small">Enter a destination or start a live route — Maplay reads pace and context in real time.</p>
        </div>
        <div class="how-step">
          <h4>2. Map + music engine</h4>
          <p class="small">Our engine matches tempo, landmarks, and mood to curate a dynamic playlist.</p>
        </div>
        <div class="how-step">
          <h4>3. Enjoy the journey</h4>
          <p class="small">Seamless transitions and adaptive mixes keep you in flow from start to finish.</p>
        </div>
      </div>
    </section>

    <!-- Social proof -->
    <section class="section" id="social">
      <h2 style="margin:0 0 12px 0">Early reactions</h2>
      <div class="testimonials">
        <div class="testimonial"><strong>“Makes my runs feel cinematic.”</strong> — Beta runner</div>
        <div class="testimonial"><strong>“Finally, playlists that understand my commute.”</strong> — Daily commuter</div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section" id="waitlist" style="text-align:center">
      <h2 style="margin:0 0 8px 0">Get early access</h2>
      <p class="lead" style="max-width:680px;margin:0 auto 18px auto">Join the waitlist to try Maplay’s adaptive playlists and help shape the product.</p>
      <a class="btn primary" href="/signup">Join the waitlist</a>
    </section>

    <!-- About / Team -->
    <section class="section" id="team">
      <div style="display:flex;gap:18px;align-items:center;flex-wrap:wrap">
        <div style="flex:1;min-width:260px">
          <h3 style="margin-top:0">About Maplay</h3>
          <p class="small">We’re building a platform where music and movement meet. Led by a founder with product and growth experience, Maplay focuses on delightful, privacy-conscious audio experiences for everyday journeys.</p>
        </div>
        <div style="flex:1;min-width:260px">
          <h3 style="margin-top:0">Join the team</h3>
          <p class="small">Hiring: technical cofounder, mobile engineers, and audio DSP experts. Interested in building with us? Apply to join the team via the waitlist form.</p>
        </div>
      </div>
    </section>

  </main>

  <footer class="container footer">
    <div>© <strong>Maplay</strong> — music that moves with you</div>
    <div style="display:flex;gap:12px;align-items:center">
      <a href="/privacy" class="small">Privacy</a>
      <a href="/terms" class="small">Terms</a>
    </div>
  </footer>
</body>
</html>
